{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PteroPilot Firestore Schema",
  "description": "User profiles, synced panel credentials, server notes, and synchronized preferences across all user devices",
  "collections": {
    "users": {
      "path": "users/{userId}",
      "description": "User profile and synced preferences document",
      "fields": {
        "userId": { "type": "string", "description": "Auth UID" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "Display name" },
        "provider": { "type": "string", "description": "Authentication provider (e.g. google.com)" },
        "photoUrl": { "type": "string", "description": "User avatar photo URL" },
        "activePanelUrl": { "type": "string", "description": "Current active Pterodactyl panel URL" },
        "activeApiToken": { "type": "string", "description": "Current active Client API token" },
        "activeLabel": { "type": "string", "description": "Profile name of active panel" },
        "themeMode": { "type": "string", "description": "App theme mode preference" },
        "appLanguage": { "type": "string", "description": "App language code" },
        "isAiEnabled": { "type": "boolean", "description": "AI diagnostics toggle" },
        "createdAt": { "type": "timestamp", "description": "Account registration timestamp" },
        "updatedAt": { "type": "timestamp", "description": "Profile update timestamp" }
      },
      "subcollections": {
        "saved_panels": {
          "path": "users/{userId}/saved_panels/{panelId}",
          "description": "Synced Pterodactyl panel connections for this user",
          "fields": {
            "id": { "type": "string", "description": "Unique panel connection ID" },
            "userId": { "type": "string", "description": "Owner user ID" },
            "label": { "type": "string", "description": "Custom user label" },
            "panelUrl": { "type": "string", "description": "Normalized HTTPS/HTTP panel URL" },
            "apiToken": { "type": "string", "description": "Client API key" },
            "lastUsedTimestamp": { "type": "number", "description": "Epoch timestamp of last connection" },
            "createdAt": { "type": "timestamp", "description": "Created timestamp" },
            "updatedAt": { "type": "timestamp", "description": "Updated timestamp" }
          }
        },
        "server_notes": {
          "path": "users/{userId}/server_notes/{noteId}",
          "description": "User favorites and notes per game server",
          "fields": {
            "id": { "type": "string", "description": "Unique note record ID" },
            "userId": { "type": "string", "description": "Owner user ID" },
            "serverIdentifier": { "type": "string", "description": "Pterodactyl 8-character server identifier" },
            "serverName": { "type": "string", "description": "Server display name" },
            "notes": { "type": "string", "description": "Personal server maintenance notes" },
            "isFavorite": { "type": "boolean", "description": "Whether server is pinned/favorited" },
            "createdAt": { "type": "timestamp", "description": "Created timestamp" },
            "updatedAt": { "type": "timestamp", "description": "Updated timestamp" }
          }
        }
      }
    }
  }
}
