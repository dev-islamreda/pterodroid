rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isValidUser(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             (!('email' in data) || data.email is string) &&
             (!('displayName' in data) || data.displayName is string) &&
             (!('photoUrl' in data) || data.photoUrl is string) &&
             (!('provider' in data) || data.provider is string) &&
             (!('activePanelUrl' in data) || data.activePanelUrl is string) &&
             (!('activeApiToken' in data) || data.activeApiToken is string) &&
             (!('activeLabel' in data) || data.activeLabel is string) &&
             (!('themeMode' in data) || data.themeMode is string) &&
             (!('appLanguage' in data) || data.appLanguage is string) &&
             (!('isAiEnabled' in data) || data.isAiEnabled is bool) &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }
    function isValidPanel(data, userId) {
      return data.id is string &&
             data.panelUrl is string &&
             data.panelUrl.size() > 0 &&
             data.apiToken is string &&
             data.apiToken.size() > 0 &&
             (!('userId' in data) || data.userId == userId) &&
             (!('label' in data) || data.label is string) &&
             (!('lastUsedTimestamp' in data) || data.lastUsedTimestamp is number) &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }
    function isValidNote(data, userId) {
      return data.id is string &&
             data.serverIdentifier is string &&
             (!('userId' in data) || data.userId == userId) &&
             (!('serverName' in data) || data.serverName is string) &&
             (!('notes' in data) || data.notes is string) &&
             (!('isFavorite' in data) || data.isFavorite is bool) &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUser(request.resource.data, userId);
      allow delete: if isOwner(userId);
      match /saved_panels/{panelId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidPanel(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }
      match /server_notes/{noteId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidNote(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
